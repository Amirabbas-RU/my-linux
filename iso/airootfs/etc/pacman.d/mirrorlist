##
## MyLinux — Arch Linux repository mirrorlist
##
## Arch's pacman-mirrorlist package ships every server commented out, so an
## image with no mirror configured cannot install anything. This file provides a
## small, curated set of official HTTPS mirrors so the live medium can run
## pacstrap and the resulting system has a working default out of the box.
##
## Regenerate on the installed system with reflector(1):
##   reflector --latest 20 --protocol https --sort rate \
##             --save /etc/pacman.d/mirrorlist
##

Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirror.leaseweb.net/archlinux/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch