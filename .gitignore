# MyLinux — generated and local artefacts
# Keep the repository free of build output, live images and secrets.

# --- ISO / image build output ---
*.iso
*.iso.sig
*.img
*.img.zst
*.qcow2
*.qcow2.*
*.raw
*.vhd
*.vmdk
out/
iso/out/
iso/work/
iso/*.iso
work/

# --- archiso intermediate state ---
iso/airootfs/usr/share/mylinux/
iso/airootfs/usr/share/doc/mylinux/
iso/airootfs/usr/local/bin/mylinux-install
iso/packages.x86_64

# --- logs / temporary files ---
*.log
*.tmp
*.swp
*.swo
*~
.cache/

# --- secrets and local environment ---
.env
.env.*
!.env.example
*.key
*.pem
!branding/**/*.pem

# --- editor / OS noise ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- python ---
__pycache__/
*.pyc
.venv/
venv/
