[Unit]
Description=MyLinux first-boot welcome
Documentation=man:mylinux(7) https://github.com/Amirabbas-RU/my-linux
ConditionPathExists=!/var/lib/mylinux/.firstboot-done
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/mylinux-welcome
ExecStartPost=/usr/bin/install -d -m 0755 /var/lib/mylinux
ExecStartPost=/usr/bin/touch /var/lib/mylinux/.firstboot-done

[Install]
WantedBy=multi-user.target
